# JSON and the paths of the trees, for the target `paths`: its octets are a path, a
# zero octet, a tree in JSON, a zero octet and a value in JSON.
separator="\x00"
object="{\"a\":"
array="[{"
close_object="}"
close_array="]"
member="\":"
comma=","
null="null"
true="true"
false="false"
number="0"
negative="-1"
large="18446744073709551615"
text="\"x\""
value="\"value\""
octets="\"octets\""
root="/"
star="/*"
end="/-"
first="/0"
escape_tilde="~0"
escape_slash="~1"
